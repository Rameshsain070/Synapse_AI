{
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "synapseai-platform/Dockerfile"
  },
  "deploy": {
    "startCommand": "cd synapseai-platform && /app/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
