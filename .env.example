# ============================================================================
# Synapse AI – Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# See ENV_SETUP.md for detailed instructions on each variable.
# ============================================================================

# ---- Application Settings ----
APP_ENV=production                  # development | staging | production | test
PROJECT_NAME="Synapse AI"
VERSION=1.0.0
DEBUG=false                         # Set true only in development

# ---- API Settings ----
API_V1_STR=/api/v1

# ---- CORS Settings ----
# Comma-separated list of allowed origins (your frontend URLs)
ALLOWED_ORIGINS="https://rameshsain070.github.io,http://localhost:3000,http://localhost:8000"

# ---- LLM Settings (Required — at least one provider) ----
OPENAI_API_KEY="your-openai-api-key"          # OpenAI API key
DEFAULT_LLM_MODEL=gpt-4o-mini                 # gpt-5-mini, gpt-4o, gpt-4o-mini, etc.
DEFAULT_LLM_TEMPERATURE=0.2                   # 0.0–1.0 (lower = more deterministic)

# ---- Google Gemini (Optional — adds Gemini models to LLM fallback chain) ----
GOOGLE_API_KEY="your-google-api-key"

# ---- JWT Authentication (Required) ----
JWT_SECRET_KEY="generate-a-strong-random-secret"   # Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ---- PostgreSQL Database (Required) ----
POSTGRES_HOST=db                    # Use "db" for Docker Compose, or your host
POSTGRES_PORT=5432
POSTGRES_DB=synapseai
POSTGRES_USER=synapseai
POSTGRES_PASSWORD=your-db-password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ---- Pinecone / Vector DB (Optional — enables semantic task search) ----
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME=synapse-tasks

# ---- Long-Term Memory ----
LONG_TERM_MEMORY_MODEL=gpt-5-nano
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# ---- Langfuse (Optional — LLM observability) ----
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Rate Limiting ----
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# ---- Logging ----
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                     # json | console
