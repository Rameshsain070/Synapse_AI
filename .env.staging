# =============================================================================
# Synapse AI – Staging Environment Template
#
# Copy to .env and fill in real values before deploying.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=staging
PROJECT_NAME=SynapseAI Platform (Staging)
VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://rameshsain070.github.io,http://localhost:3000

# ── LLM (Required) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-staging-openai-key
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.7

# ── LLM (Optional – Gemini fallback) ────────────────────────────────────────
# GOOGLE_API_KEY=your-google-api-key

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=your-staging-db-host
POSTGRES_PORT=5432
POSTGRES_DB=synapseai_staging
POSTGRES_USER=synapseai
POSTGRES_PASSWORD=your-staging-db-password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# ── Vector DB (Optional – Pinecone) ─────────────────────────────────────────
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX_NAME=synapseai-staging

# ── Long-Term Memory ────────────────────────────────────────────────────────
LONG_TERM_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_LLM_MODEL=gpt-4o-mini
LONG_TERM_MEMORY_COLLECTION_NAME=synapseai_memory_staging

# ── Observability (Optional – Langfuse) ─────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=200 per minute

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
