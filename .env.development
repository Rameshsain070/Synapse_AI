# =============================================================================
# Synapse AI – Development Environment Template
#
# Copy to .env for local development.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
PROJECT_NAME=SynapseAI Platform (Dev)
VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://rameshsain070.github.io

# ── LLM (Required) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-dev-openai-key
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.7

# ── LLM (Optional – Gemini fallback) ────────────────────────────────────────
# GOOGLE_API_KEY=your-google-api-key

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-not-for-production-use-a-real-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ── PostgreSQL (Docker Compose) ──────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=synapseai
POSTGRES_USER=synapseai
POSTGRES_PASSWORD=synapseai
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# ── Vector DB (Optional – Pinecone) ─────────────────────────────────────────
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX_NAME=synapseai-dev

# ── Long-Term Memory ────────────────────────────────────────────────────────
LONG_TERM_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_LLM_MODEL=gpt-4o-mini
LONG_TERM_MEMORY_COLLECTION_NAME=synapseai_memory_dev

# ── Observability (Optional – Langfuse) ─────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=500 per minute

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=console
